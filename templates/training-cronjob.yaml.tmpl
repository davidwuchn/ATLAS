# Nightly cost-field retraining — runs when ATLAS_ENABLE_TRAINING=true.
# install.sh applies this only on opt-in (`kubectl apply ... || true`)
# so a render failure here doesn't block the rest of the deploy. The
# command is a thin wrapper that POSTs /internal/lens/retrain on the
# geometric-lens Service.
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: lens-retrain
  namespace: ${ATLAS_NAMESPACE}
spec:
  schedule: "${ATLAS_TRAINING_SCHEDULE}"
  concurrencyPolicy: Forbid       # Long retrains; never overlap.
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      template:
        spec:
          restartPolicy: OnFailure
          containers:
          - name: trigger
            image: curlimages/curl:8.5.0
            command: ["sh", "-c"]
            args:
            - >-
              curl -fsSL --max-time 1800
              -X POST http://geometric-lens:${ATLAS_LENS_PORT}/internal/lens/retrain
              -H 'Content-Type: application/json'
              -d '{"min_rating": ${ATLAS_TRAINING_MIN_RATING}, "validation_threshold": ${ATLAS_TRAINING_VALIDATION_THRESHOLD}}'
            resources:
              requests: {cpu: "100m", memory: "128Mi"}
              limits:   {cpu: "500m", memory: "256Mi"}
